# Fichiers LaTeX auxiliaires
*.aux
*.log
*.out
*.toc
*.synctex.gz
*.fls
*.fdb_latexmk
*.bbl
*.blg
*.nav
*.snm
*.vrb

# Fichiers macOS
.DS_Store
._*

# Fichiers d'éditeurs
.vscode/
*.swp
*~

# Fichiers de compilation : on ignore tous les PDF...
*.pdf

# ...sauf ceux explicitement listés ci-dessous
!exemples/*.pdf
!examples/*.pdf
!doc/*.pdf

# Anciens fichiers de test (hors suivi Git)
/test_*.tex
/test-*.tex
/testminimal.tex
tests/anciens/

# Fichiers synctex en cours d'écriture
*.synctex.gz(busy)

# PDF d'exemples : régénéré par `make compile`, non suivi
examples/exemples.pdf
