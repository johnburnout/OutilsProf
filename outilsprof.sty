% ------------------------------------------------------------
% Cumul (différencie angles et durées)
% ------------------------------------------------------------
\cs_new_protected:Npn \__dop_cumul_add:n #1
{
    \__dop_parse:n {#1}
    \bool_if:NTF \l__dop_angles_bool
        {
            \int_gadd:Nn \g__dop_j_int { \l_tmpa_int }
            \int_gadd:Nn \g__dop_m_int { \l_tmpb_int }
            \int_gadd:Nn \g__dop_s_int { \l_tmpc_int }
        }
        {
            \int_gadd:Nn \g__dop_j_int { \l_tmpa_int }
            \int_gadd:Nn \g__dop_h_int { \l_tmpb_int }
            \int_gadd:Nn \g__dop_m_int { \l_tmpc_int }
            \int_gadd:Nn \g__dop_s_int { \l_tmpd_int }
        }
}

\cs_new_protected:Npn \__dop_cumul_sub:n #1
{
    \__dop_parse:n {#1}
    \bool_if:NTF \l__dop_angles_bool
        {
            \int_gsub:Nn \g__dop_j_int { \l_tmpa_int }
            \int_gsub:Nn \g__dop_m_int { \l_tmpb_int }
            \int_gsub:Nn \g__dop_s_int { \l_tmpc_int }
        }
        {
            \int_gsub:Nn \g__dop_j_int { \l_tmpa_int }
            \int_gsub:Nn \g__dop_h_int { \l_tmpb_int }
            \int_gsub:Nn \g__dop_m_int { \l_tmpc_int }
            \int_gsub:Nn \g__dop_s_int { \l_tmpd_int }
        }
}

% ------------------------------------------------------------
% Normalisation + extraction du signe
% ------------------------------------------------------------
\cs_new_protected:Npn \__dop_normaliser_et_signer:
{
    \bool_if:NTF \l__dop_angles_bool
        {
            \int_gset:Nn \g__dop_total_int
                { \g__dop_j_int * 3600
                  + \g__dop_m_int * 60
                  + \g__dop_s_int }
            \int_compare:nTF { \g__dop_total_int < 0 }
                { \int_gset:Nn \g__dop_signe_int { -1 } }
                { \int_gset:Nn \g__dop_signe_int { 1 } }
            \int_compare:nT { \g__dop_total_int < 0 }
                { \int_gset:Nn \g__dop_total_int
                    { -\g__dop_total_int } }
            \int_gset:Nn \g__dop_j_int
                { \int_div_truncate:nn { \g__dop_total_int } { 3600 } }
            \int_gset:Nn \g__dop_total_int
                { \int_mod:nn { \g__dop_total_int } { 3600 } }
            \int_gset:Nn \g__dop_m_int
                { \int_div_truncate:nn { \g__dop_total_int } { 60 } }
            \int_gset:Nn \g__dop_s_int
                { \int_mod:nn { \g__dop_total_int } { 60 } }
            \int_gzero:N \g__dop_h_int
        }
        {
            \int_gset:Nn \g__dop_total_int
                { \g__dop_j_int * 86400
                  + \g__dop_h_int * 3600
                  + \g__dop_m_int * 60
                  + \g__dop_s_int }
            \int_compare:nTF { \g__dop_total_int < 0 }
                { \int_gset:Nn \g__dop_signe_int { -1 } }
                { \int_gset:Nn \g__dop_signe_int { 1 } }
            \int_compare:nT { \g__dop_total_int < 0 }
                { \int_gset:Nn \g__dop_total_int
                    { -\g__dop_total_int } }
            \int_gset:Nn \g__dop_j_int
                { \int_div_truncate:nn { \g__dop_total_int } { 86400 } }
            \int_gset:Nn \g__dop_total_int
                { \int_mod:nn { \g__dop_total_int } { 86400 } }
            \int_gset:Nn \g__dop_h_int
                { \int_div_truncate:nn { \g__dop_total_int } { 3600 } }
            \int_gset:Nn \g__dop_total_int
                { \int_mod:nn { \g__dop_total_int } { 3600 } }
            \int_gset:Nn \g__dop_m_int
                { \int_div_truncate:nn { \g__dop_total_int } { 60 } }
            \int_gset:Nn \g__dop_s_int
                { \int_mod:nn { \g__dop_total_int } { 60 } }
        }
}

% ------------------------------------------------------------
% Rendu commun
% ------------------------------------------------------------
\cs_new_protected:Npn \__dop_rendre:nn #1 #2
{
    \group_begin:
    \keys_set:nn { outilsprof / dureeop } { #1 }
    \seq_set_from_clist:Nn \l__dop_termes_seq { #2 }
    \int_set:Nn \l__dop_nb_int { \seq_count:N \l__dop_termes_seq }

    \int_gzero:N \g__dop_j_int
    \int_gzero:N \g__dop_h_int
    \int_gzero:N \g__dop_m_int
    \int_gzero:N \g__dop_s_int

    \int_set:Nn \l__dop_i_int { 1 }
    \seq_map_inline:Nn \l__dop_termes_seq
    {
        \int_compare:nTF { \l__dop_i_int == 1 }
            { \__dop_cumul_add:n {##1} }
            {
                \bool_if:NTF \l__dop_addition_bool
                    { \__dop_cumul_add:n {##1} }
                    { \__dop_cumul_sub:n {##1} }
            }
        \int_incr:N \l__dop_i_int
    }

    \__dop_normaliser_et_signer:

    \__dop_calculer_derniere_col:
    \__dop_calculer_fin_trait:

    \int_set:Nn \l__dop_hauteur_int { \l__dop_nb_int + 1 }
    \bool_if:NT \l__dop_solution_bool
        { \int_incr:N \l__dop_hauteur_int }

    \begin{center}
    \begin{tikzpicture}[x=1mm, y=1mm]
        \useasboundingbox
            (0, 3mm)
            rectangle ( { \l__dop_fin_dim + 3mm } ,
                        { -\l__dop_hauteur_int * 6mm } );

        \int_set:Nn \l__dop_ligne_int { 1 }
        \seq_map_inline:Nn \l__dop_termes_seq
        {
            \int_compare:nT { \l__dop_ligne_int > 1 }
            {
                \bool_if:NTF \l__dop_addition_bool
                    {
                        \node[anchor=east]
                            at ( 10mm , { -(\l__dop_ligne_int - 0.5) * 6mm } )
                            {$+$};
                    }
                    {
                        \node[anchor=east]
                            at ( 10mm , { -(\l__dop_ligne_int - 0.5) * 6mm } )
                            {$-$};
                    }
            }
            \__dop_terme_colonnes:nn {##1} { \l__dop_ligne_int }
            \int_incr:N \l__dop_ligne_int
        }

        \draw ( 5mm , { -\l__dop_ligne_int * 6mm + 2mm } )
            -- ( \l__dop_fin_dim , { -\l__dop_ligne_int * 6mm + 2mm } );

        \bool_if:NT \l__dop_solution_bool
        {
            \__dop_resultat_colonnes:n { \l__dop_ligne_int + 1 }
        }
    \end{tikzpicture}
    \end{center}
    \group_end:
}

