\int_new:N \l__div_dividende_int
\int_new:N \l__div_diviseur_int
\int_new:N \l__div_quotient_int
\int_new:N \l__div_reste_int
\int_new:N \l__div_nbchiffres_int
\int_new:N \l__div_puissance_int
\int_new:N \l__div_chiffre_int
\int_new:N \l__div_partiel_int
\int_new:N \l__div_produit_int
\bool_new:N \l__div_premiere_bool
\seq_new:N \l__div_etapes_seq
\tl_new:N  \l__div_dividende_tl
\tl_new:N  \l__div_diviseur_tl
\tl_new:N  \l__div_quotient_tl
\tl_new:N  \l__div_reste_tl

\newcounter{divEtape}
\newlength{\chiffreLargeur}
\AtBeginDocument{\settowidth{\chiffreLargeur}{0}}

\cs_new_protected:Npn \__div_afficher_etape_aux:n #1
{
    \exp_after:wN \__div_afficher_etape_auxii:nn #1
}
\cs_new_protected:Npn \__div_afficher_etape_auxii:nn #1 #2
{
    \tl_if_blank:nTF {#1}
        {
            \hspace*{\dimexpr\numexpr\thedivEtape+1\relax\chiffreLargeur\relax}%
            \begin{tabular}[t]{@{}r@{}}
                #2 \\
                \cline{1-1}
                \phantom{0} \\
            \end{tabular}
        }
        {
            \hspace*{\dimexpr\thedivEtape\chiffreLargeur\relax}%
            \begin{tabular}[t]{@{}r@{}}
                #1 \\
                #2 \\
                \cline{1-1}
                \the\numexpr #1 - #2 \relax \\
            \end{tabular}
        }
}

\cs_new_protected:Npn \__op_rendre_division:nnn #1 #2 #3
{
    \group_begin:
    \keys_set:nn { outilsprof / operation } { #1 }
    \__op_appliquer_taille:

    \tl_set:Nn \l__div_dividende_tl {#2}
    \tl_set:Nn \l__div_diviseur_tl  {#3}
    \int_set:Nn \l__div_dividende_int {#2}
    \int_set:Nn \l__div_diviseur_int  {#3}
    \int_set:Nn \l__div_nbchiffres_int
        { \tl_count:N \l__div_dividende_tl }

    \int_compare:nTF { \l__div_diviseur_int == 0 }
    {
        \tl_set:Nn \l__div_quotient_tl { 0 }
        \tl_set:Nn \l__div_reste_tl    { 0 }
        \seq_clear:N \l__div_etapes_seq
    }
    {
        \tl_set:Nx \l__div_quotient_tl
            { \int_eval:n
                { \l__div_dividende_int / \l__div_diviseur_int } }
        \int_set:Nn \l__div_quotient_int { \l__div_quotient_tl }
        \int_set:Nn \l_tmpa_int
            { \int_mod:nn { \l__div_dividende_int } { \l__div_diviseur_int } }
        \tl_set:Nx \l__div_reste_tl { \int_use:N \l_tmpa_int }

        % --- Pré-calcul des étapes ---
        \seq_clear:N \l__div_etapes_seq
        \int_zero:N \l__div_partiel_int
        \int_set:Nn \l__div_puissance_int { 1 }
        \int_step_inline:nn { \l__div_nbchiffres_int - 1 }
            { \int_set:Nn \l__div_puissance_int
                { \l__div_puissance_int * 10 } }

        \bool_set_true:N \l__div_premiere_bool
        \int_step_inline:nn { \l__div_nbchiffres_int }
        {
            \int_set:Nn \l__div_chiffre_int
                { \int_div_truncate:nn
                    { \l__div_dividende_int }
                    { \l__div_puissance_int } }
            \int_set:Nn \l__div_chiffre_int
                { \int_mod:nn { \l__div_chiffre_int } { 10 } }
            \int_set:Nn \l__div_partiel_int
                { \l__div_partiel_int * 10 + \l__div_chiffre_int }

            \int_compare:nT { \l__div_partiel_int >= \l__div_diviseur_int }
            {
                \int_set:Nn \l__div_produit_int
                    { \int_div_truncate:nn
                        { \l__div_partiel_int }
                        { \l__div_diviseur_int } }
                \int_set:Nn \l__div_produit_int
                    { \l__div_produit_int * \l__div_diviseur_int }

                \bool_if:NTF \l__div_premiere_bool
                    {
                        \seq_put_right:Nx \l__div_etapes_seq
                            { { } { \int_use:N \l__div_produit_int } }
                        \bool_set_false:N \l__div_premiere_bool
                    }
                    {
                        \seq_put_right:Nx \l__div_etapes_seq
                            { { \int_use:N \l__div_partiel_int }
                              { \int_use:N \l__div_produit_int } }
                    }

                \int_set:Nn \l__div_partiel_int
                    { \l__div_partiel_int - \l__div_produit_int }
            }

            \int_set:Nn \l__div_puissance_int
                { \l__div_puissance_int / 10 }
        }
    }

    % =====================================================
    % AFFICHAGE
    % =====================================================
    \begin{center}
    \begin{tabular}{@{}r@{\hspace{4pt}}|@{\hspace{4pt}}l@{}}
        \l__div_dividende_tl & \l__div_diviseur_tl \\
        \cline{2-2}
         & \bool_if:NTF \l__op_solution_bool
             { \l__div_quotient_tl }
             { \phantom{0} } \\
    \end{tabular}

    \bool_if:NTF \l__op_solution_bool
    {
        \int_compare:nT { \l__div_diviseur_int > 0 }
        {
            \par\vspace{6pt}
            \setcounter{divEtape}{-3}%
            \begin{tabular}{@{}l@{}}
                \seq_map_inline:Nn \l__div_etapes_seq
                {
                    \__div_afficher_etape_aux:n {##1} \\[2pt]
                    \global\advance\c@divEtape by 1\relax
                }
            \end{tabular}
        }
    }
    { }
    \end{center}
    \group_end:
}

