\ExplSyntaxOn

% ------------------------------------------------------------
% Variables internes (communes)
% ------------------------------------------------------------
\seq_new:N    \l__op_liste_seq
\int_new:N    \l__op_somme_int
\int_new:N    \l__op_i_int
\int_new:N    \l__op_n_int
\int_new:N    \l__op_a_int
\int_new:N    \l__op_b_int
\tl_new:N     \l__op_taille_tl
\tl_new:N     \l__op_resultat_tl

\keys_define:nn { outilsprof / operation }
{
    solution .bool_set:N = \l__op_solution_bool,
    solution .initial:n  = false,
    taille   .tl_set:N   = \l__op_taille_tl,
    taille   .initial:n  = normalsize,
}

\cs_new_protected:Npn \__op_appliquer_taille:
{
    \csname \l__op_taille_tl \endcsname
}

\cs_new_protected:Npn \__op_parse:n #1
{
    \seq_clear:N \l__op_liste_seq
    \clist_map_inline:nn { #1 }
    {
        \tl_set:Nn \l_tmpa_tl {##1}
        \tl_trim_spaces:N \l_tmpa_tl
        \tl_if_empty:NF \l_tmpa_tl
            { \seq_put_right:NV \l__op_liste_seq \l_tmpa_tl }
    }
    \int_set:Nn \l__op_n_int { \seq_count:N \l__op_liste_seq }
}

\cs_new_protected:Npn \__op_calculer_somme:
{
    \int_zero:N \l__op_somme_int
    \seq_map_inline:Nn \l__op_liste_seq
    {
        \int_set:Nn \l_tmpa_int {##1}
        \int_add:Nn \l__op_somme_int { \l_tmpa_int }
    }
}

\cs_new_protected:Npn \__op_calculer_difference:
{
    \int_zero:N \l__op_somme_int
    \int_zero:N \l__op_i_int
    \seq_map_inline:Nn \l__op_liste_seq
    {
        \int_incr:N \l__op_i_int
        \int_set:Nn \l_tmpa_int {##1}
        \int_compare:nTF { \l__op_i_int == 1 }
            { \int_set:Nn \l__op_somme_int { \l_tmpa_int } }
            { \int_sub:Nn \l__op_somme_int { \l_tmpa_int } }
    }
}

\cs_new_protected:Npn \__op_calculer_produit:
{
    \int_set:Nn \l__op_somme_int { 1 }
    \seq_map_inline:Nn \l__op_liste_seq
    {
        \int_set:Nn \l_tmpa_int {##1}
        \int_set:Nn \l__op_somme_int
            { \l__op_somme_int * \l_tmpa_int }
    }
}

% ============================================================
% ADDITION
% ============================================================
\cs_new_protected:Npn \__op_rendre_addition:nn #1 #2
{
    \group_begin:
    \keys_set:nn { outilsprof / operation } { #1 }
    \__op_parse:n { #2 }
    \__op_calculer_somme:
    \tl_set:Nx \l__op_resultat_tl { \int_use:N \l__op_somme_int }
    \__op_appliquer_taille:

    \begin{center}
    \begin{tabular}{@{}r@{}}
        \seq_item:Nn \l__op_liste_seq { 1 } \\
        \int_step_inline:nn { \l__op_n_int - 1 }
        {
            + \, \seq_item:Nn \l__op_liste_seq { ##1 + 1 } \\
        }
        \\[-1ex]
        \cline{1-1}
        \\[-1ex]
        \bool_if:NTF \l__op_solution_bool
            { \l__op_resultat_tl }
            { \phantom{0} }
    \end{tabular}
    \end{center}
    \group_end:
}

% ============================================================
% SOUSTRACTION
% ============================================================
\cs_new_protected:Npn \__op_rendre_soustraction:nn #1 #2
{
    \group_begin:
    \keys_set:nn { outilsprof / operation } { #1 }
    \__op_parse:n { #2 }
    \int_compare:nTF { \l__op_n_int == 2 }
    {
        \tl_set:Nx \l_tmpa_tl { \seq_item:Nn \l__op_liste_seq { 1 } }
        \tl_set:Nx \l_tmpb_tl { \seq_item:Nn \l__op_liste_seq { 2 } }
        \int_set:Nn \l_tmpa_int { \l_tmpa_tl }
        \int_set:Nn \l_tmpb_int { \l_tmpb_tl }
        \int_compare:nTF { \l_tmpa_int >= \l_tmpb_int }
        {
            \tl_set_eq:NN \l_tmpc_tl \l_tmpa_tl
            \tl_set_eq:NN \l_tmpd_tl \l_tmpb_tl
            \int_set:Nn \l__op_somme_int { \l_tmpa_int - \l_tmpb_int }
        }
        {
            \tl_set_eq:NN \l_tmpc_tl \l_tmpb_tl
            \tl_set_eq:NN \l_tmpd_tl \l_tmpa_tl
            \int_set:Nn \l__op_somme_int { \l_tmpb_int - \l_tmpa_int }
        }
        \tl_set:Nx \l__op_resultat_tl { \int_use:N \l__op_somme_int }
        \__op_appliquer_taille:

        \begin{center}
        \begin{tabular}{@{}r@{}}
            \l_tmpc_tl \\
            - \, \l_tmpd_tl \\
            \\[-1ex]
            \cline{1-1}
            \\[-1ex]
            \bool_if:NTF \l__op_solution_bool
                { \l__op_resultat_tl }
                { \phantom{0} }
        \end{tabular}
        \end{center}
    }
    {
        \GenericError{}
            {outilsprof : \soustraction~attend~exactement~2~termes}
            {Voir~la~documentation~de~outilsprof}
            {Exemple~:~\soustraction\{853,~476\}}
    }
    \group_end:
}

% ============================================================
% MULTIPLICATION
% ============================================================
\int_new:N \l__mul_a_int
\int_new:N \l__mul_b_int
\int_new:N \l__mul_nb_int
\int_new:N \l__mul_i_int
\int_new:N \l__mul_chiffre_int
\int_new:N \l__mul_puissance_int
\int_new:N \l__mul_produit_int
\tl_new:N  \l__mul_multiplicande_tl
\tl_new:N  \l__mul_multiplicateur_tl
\tl_new:N  \l__mul_produit_final_tl
\seq_new:N \l__mul_produits_seq

\cs_new_protected:Npn \__op_rendre_multiplication:nn #1 #2
{
    \group_begin:
    \keys_set:nn { outilsprof / operation } { #1 }
    \__op_parse:n { #2 }

    \int_compare:nTF { \l__op_n_int == 2 }
    {
        \tl_set:Nx \l__mul_multiplicande_tl
            { \seq_item:Nn \l__op_liste_seq { 1 } }
        \tl_set:Nx \l__mul_multiplicateur_tl
            { \seq_item:Nn \l__op_liste_seq { 2 } }
        \int_set:Nn \l__mul_a_int { \l__mul_multiplicande_tl }
        \int_set:Nn \l__mul_b_int { \l__mul_multiplicateur_tl }

        \int_set:Nn \l__mul_nb_int
            { \tl_count:N \l__mul_multiplicateur_tl }

        \tl_set:Nx \l__mul_produit_final_tl
            { \int_eval:n { \l__mul_a_int * \l__mul_b_int } }

        \seq_clear:N \l__mul_produits_seq
        \int_compare:nT { \l__mul_nb_int > 1 }
        {
            \int_set:Nn \l__mul_puissance_int { 1 }
            \int_step_inline:nn { \l__mul_nb_int }
            {
                \int_set:Nn \l__mul_chiffre_int
                    { \int_mod:nn
                        { \int_div_truncate:nn
                            { \l__mul_b_int }
                            { \l__mul_puissance_int } }
                        { 10 } }
                \int_set:Nn \l__mul_produit_int
                    { \l__mul_a_int * \l__mul_chiffre_int * \l__mul_puissance_int }
                \seq_put_right:Nx \l__mul_produits_seq
                    { \int_use:N \l__mul_produit_int }
                \int_set:Nn \l__mul_puissance_int
                    { \l__mul_puissance_int * 10 }
            }
        }

        \__op_appliquer_taille:
        \begin{center}
        \begin{tabular}{@{}r@{}}
            \l__mul_multiplicande_tl \\
            $\times$ \, \l__mul_multiplicateur_tl \\
            \\[-1ex]
            \cline{1-1}
            \\[-1ex]
            \seq_map_inline:Nn \l__mul_produits_seq
                { ##1 \\ }
            \int_compare:nT { \l__mul_nb_int > 1 }
            {
                \\[-1ex]
                \cline{1-1}
                \\[-1ex]
            }
            \bool_if:NTF \l__op_solution_bool
                { \l__mul_produit_final_tl }
                { \phantom{0} }
        \end{tabular}
        \end{center}
    }
    {
        \GenericError{}
            {outilsprof : \multiplication~attend~exactement~2~facteurs}
            {Voir~la~documentation~de~outilsprof}
            {Exemple~:~\multiplication\{234,~56\}}
    }
    \group_end:
}

