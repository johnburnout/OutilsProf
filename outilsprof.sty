% ------------------------------------------------------------
% Réponses à compléter
% ------------------------------------------------------------
% \reponse           → ligne de 6 cm (défaut)
% \reponse[3cm]      → ligne de 3 cm
% \grandeReponse     → ligne sur toute la largeur du texte
% \grandeReponse[0.5]→ ligne sur 50 % de la largeur

\newcommand{\reponse}[1][6cm]{%
    \rule[-0.5ex]{#1}{0.4pt}%
}

\newcommand{\grandeReponse}[1][1]{%
    \rule[-0.5ex]{\dimexpr #1\textwidth\relax}{0.4pt}%
}

