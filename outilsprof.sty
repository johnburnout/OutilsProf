\cs_new_protected:Npn \__repere_recuperer:n #1
{
    \keys_set:nn { outilsprof / reperegradue } { #1 }
    \tl_set:Nx \repereLongueur { \l__repere_longueur_tl }
    \tl_set:Nx \repereBG       { \l__repere_bg_tl }
    \tl_set:Nx \repereHD       { \l__repere_hd_tl }
    \tl_set:Nx \repereOrigine  { \l__repere_origine_tl }
    \tl_set:Nx \repereGrille   { \l__repere_grille_tl }
    \tl_set:Nx \reperePasX     { \l__repere_pasx_tl }
    \tl_set:Nx \reperePasY     { \l__repere_pasy_tl }
