% ============================================================
% DIVISION POSÉE EN TIKZ
% ============================================================
\newcounter{divLigne}

\newcommand{\divPlaceNombre}[4]{%
    \foreach \chiffre [count=\i from 0] in {#1} {%
        \pgfmathsetmacro{\pos}{#3 - (#2 - 1 - \i)}%
        \node[anchor=center, inner sep=0pt] at (\pos, -#4) {\chiffre};%
    }%
}

\newcommand{\divTraceTrait}[3]{%
    \pgfmathsetmacro{\xdebut}{#2 - #1 + 0.8}%
    \pgfmathsetmacro{\xfin}{#2 + 0.2}%
    \draw[thick] (\xdebut, -#3 - 0.35) -- (\xfin, -#3 - 0.35);%
}

\newcommand{\divAfficheEtape}[5]{%
    \ifx\relax#1\relax\else
        \divPlaceNombre{#1}{#2}{#5}{\thedivLigne}%
        \stepcounter{divLigne}%
    \fi
    \ifx\relax#3\relax\else
        \divPlaceNombre{#3}{#4}{#5}{\thedivLigne}%
        \divTraceTrait{#4}{#5}{\thedivLigne}%
        \stepcounter{divLigne}%
    \fi
}

\newcommand{\divTikzDebut}[5]{%
    \begin{tikzpicture}[x=0.6cm, y=0.8cm, every node/.style={font=\normalsize}]
        \useasboundingbox (-0.5, 0.8) rectangle (#4 + 4, -#5);

        \foreach \chiffre [count=\i from 0] in {#1} {
            \node[anchor=center, inner sep=0pt] at (\i, 0) {\chiffre};
        }

        \draw[thick] (#4 - 0.3, 0.6) -- (#4 - 0.3, -1.5);
        \node[anchor=west] at (#4 + 0.2, 0) {#2};
        \node[anchor=west] at (#4 + 0.2, -1) {#3};
        \draw[thick] (#4 - 0.1, -0.5) -- (#4 + 1.8, -0.5);

        \setcounter{divLigne}{1}%
}

\newcommand{\divTikzFin}{%
    \end{tikzpicture}%
}

\newcommand{\divCalculerEtapes}[2]{%
    \gdef\divEtapesTexte{}%
    \pgfmathsetmacro{\divQuotient}{int(#1 / #2)}%
    \pgfmathsetmacro{\divReste}{#1 - \divQuotient * #2}%
    \StrLen{#1}[\divNbChiffres]%
    \def\divPartiel{0}%
    \def\divNbPartiel{0}%
    \def\divColFin{0}%
    \gdef\divDejaAffiche{0}%
    \foreach \chiffre [count=\i from 1] in {#1} {%
        \ifnum\divPartiel=0
            \xdef\divPartiel{\chiffre}%
            \xdef\divNbPartiel{1}%
        \else
            \xdef\divPartiel{\divPartiel\chiffre}%
            \xdef\divNbPartiel{\the\numexpr\divNbPartiel+1\relax}%
        \fi
        \ifnum\divPartiel<\numexpr#2\relax\else
            \pgfmathsetmacro{\divChiffreQ}{int(\divPartiel / #2)}%
            \pgfmathsetmacro{\divProduit}{\divChiffreQ * #2}%
            \pgfmathsetmacro{\divNouveauPartiel}{\divPartiel - \divProduit}%
            \xdef\divColFin{\i}%
            \StrLen{\divProduit}[\divNbProduit]%
            \ifnum\divDejaAffiche=0
                \xdef\divEtapesTexte{\divEtapesTexte
                    \noexpand\divAfficheEtape{}{0}{\divProduit}{\divNbProduit}{\divColFin}}%
                \gdef\divDejaAffiche{1}%
            \else
                \xdef\divEtapesTexte{\divEtapesTexte
                    \noexpand\divAfficheEtape{\divPartiel}{\divNbPartiel}{\divProduit}{\divNbProduit}{\divColFin}}%
            \fi
            \xdef\divPartiel{\divNouveauPartiel}%
            \ifnum\divPartiel=0
                \xdef\divNbPartiel{0}%
            \else
                \StrLen{\divPartiel}[\divNbPartiel]%
            \fi
        \fi
    }%
    \ifnum\divReste>0
        \StrLen{\divReste}[\divNbReste]%
        \xdef\divEtapesTexte{\divEtapesTexte
            \noexpand\divAfficheEtape{}{0}{\divReste}{\divNbReste}{\divNbChiffres}}%
    \fi
}

\newcommand{\divisionTikz}[2]{%
    \divCalculerEtapes{#1}{#2}%
    \pgfmathsetmacro{\divQuotient}{int(#1 / #2)}%
    \StrLen{#1}[\divNbChiffres]%
    \pgfmathsetmacro{\divHauteur}{2 + 3 * (\divNbChiffres + 1)}%
    \divTikzDebut{#1}{#2}{\divQuotient}{\divNbChiffres}{\divHauteur}%
    \divEtapesTexte
    \divTikzFin
}

