    etapes    .initial:n  = {},
}

% ------------------------------------------------------------
% Calcul interne
% Séquence : "position;partiel;produit" par étape
% ------------------------------------------------------------
\cs_new_protected:Npn \__div_calculer:
{
    \int_set:Nn \l__div_dividende_int { \l__div_dividende_tl }
    \int_set:Nn \l__div_diviseur_int  { \l__div_diviseur_tl }

    \int_set:Nn \l__div_quotient_int
        { \int_div_truncate:nn
            { \l__div_dividende_int }
            { \l__div_diviseur_int } }
    \int_set:Nn \l__div_reste_int
        { \int_mod:nn
            { \l__div_dividende_int }
            { \l__div_diviseur_int } }
    \tl_set:Nx \l__div_quotient_tl
        { \int_use:N \l__div_quotient_int }
    \tl_set:Nx \l__div_reste_tl
        { \int_use:N \l__div_reste_int }

    \int_set:Nn \l__div_nbchiffres_int
        { \tl_count:N \l__div_dividende_tl }
    \int_set:Nn \l__div_nbdiv_int
        { \tl_count:N \l__div_diviseur_tl }
    \int_set:Nn \l__div_nbquo_int
        { \tl_count:N \l__div_quotient_tl }

    \int_set:Nn \l__div_nbcol_droite_int
        { \int_max:nn
            { \l__div_nbdiv_int }
            { \l__div_nbquo_int } }

    \seq_clear:N \l__div_etapes_calc_seq
    \int_zero:N \l__div_partiel_int
    \int_zero:N \l__div_nb_etapes_int
    \int_set:Nn \l__div_puissance_int { 1 }

    \int_set:Nn \l_tmpc_int { 1 }
    \int_while_do:nNnn { \l_tmpc_int } < { \l__div_nbchiffres_int }
    {
        \int_set:Nn \l__div_puissance_int
            { \l__div_puissance_int * 10 }
        \int_set:Nn \l_tmpc_int { \l_tmpc_int + 1 }
    }

    \int_set:Nn \l_tmpc_int { 1 }
    \int_while_do:nNnn { \l_tmpc_int } < { \l__div_nbchiffres_int + 1 }
    {
        \int_set:Nn \l__div_chiffre_int
            { \int_div_truncate:nn
                { \l__div_dividende_int }
                { \l__div_puissance_int } }
        \int_set:Nn \l__div_chiffre_int
            { \int_mod:nn { \l__div_chiffre_int } { 10 } }
        \int_set:Nn \l__div_partiel_int
            { \l__div_partiel_int * 10 + \l__div_chiffre_int }

        \int_compare:nT
            { \l__div_partiel_int >= \l__div_diviseur_int }
        {
            \int_set:Nn \l__div_produit_int
                { \int_div_truncate:nn
                    { \l__div_partiel_int }
                    { \l__div_diviseur_int } }
            \int_set:Nn \l__div_produit_int
                { \l__div_produit_int * \l__div_diviseur_int }

            \int_compare:nTF { \l__div_nb_etapes_int == 0 }
                {
                    \seq_put_right:Nx \l__div_etapes_calc_seq
                        { \int_use:N \l_tmpc_int
                          ; 0
                          ; \int_use:N \l__div_produit_int }
                }
                {
                    \seq_put_right:Nx \l__div_etapes_calc_seq
                        { \int_use:N \l_tmpc_int
                          ; \int_use:N \l__div_partiel_int
                          ; \int_use:N \l__div_produit_int }
                }
            \int_set:Nn \l__div_nb_etapes_int
                { \l__div_nb_etapes_int + 1 }

            \int_set:Nn \l__div_partiel_int
                { \l__div_partiel_int - \l__div_produit_int }
        }

        \int_set:Nn \l__div_puissance_int
            { \l__div_puissance_int / 10 }
        \int_set:Nn \l_tmpc_int { \l_tmpc_int + 1 }
    }
}

% ------------------------------------------------------------
% Macro sans argument : découpe \l_tmpa_tl (format "a;b;c") en :
%   \l_tmpa_tl = a, \l_tmpb_tl = b, \l_tmpc_tl = c
% ------------------------------------------------------------
\cs_new_protected:Npn \__div_decouper_trois:
{
    \expandafter\StrCut\expandafter{\l_tmpa_tl}{;}
        {\l_tmpa_tl}{\l_tmpb_tl}
    \expandafter\StrCut\expandafter{\l_tmpb_tl}{;}
        {\l_tmpb_tl}{\l_tmpc_tl}
}

% ------------------------------------------------------------
% Vérification des étapes fournies
% ------------------------------------------------------------
\cs_new_protected:Npn \__div_verifier_etapes:
{
    \bool_set_true:N \l__div_etapes_ok_bool
    \bool_set_false:N \l__div_etapes_fournies_bool
    \tl_if_empty:NF \l__div_etapes_user_tl
    {
        \bool_set_true:N \l__div_etapes_fournies_bool
        \tl_set:Nx \l__div_etapes_user_tl
            { \tl_to_str:V \l__div_etapes_user_tl }
        \tl_replace_all:Nnn \l__div_etapes_user_tl { ~ } { }
        \tl_replace_all:Nnn \l__div_etapes_user_tl
            { \c_space_token } { }

        \seq_clear:N \l_tmpa_seq
        \int_set:Nn \l_tmpc_int { 1 }
        \int_while_do:nNnn { \l_tmpc_int }
            < { \l__div_nb_etapes_int + 1 }
        {
            \tl_set:Nx \l_tmpa_tl
                { \seq_item:Nn \l__div_etapes_calc_seq
                    { \l_tmpc_int } }
            \__div_decouper_trois:
            \seq_put_right:NV \l_tmpa_seq \l_tmpc_tl
            \int_set:Nn \l_tmpc_int { \l_tmpc_int + 1 }
        }
        \tl_set:Nx \l_tmpa_tl
            { \seq_use:Nn \l_tmpa_seq { , } }

        \tl_if_eq:NNTF \l_tmpa_tl \l__div_etapes_user_tl
            { \bool_set_true:N \l__div_etapes_ok_bool }
            { \bool_set_false:N \l__div_etapes_ok_bool }
    }
}

% ------------------------------------------------------------
% Paramètres géométriques TikZ
% ------------------------------------------------------------
\dim_new:N \l__div_h_dim
\dim_new:N \l__div_w_dim
\dim_new:N \l__div_sep_dim
\dim_set:Nn \l__div_h_dim { 5mm }
\dim_set:Nn \l__div_w_dim { 5mm }
\dim_set:Nn \l__div_sep_dim { 0.4pt }

\cs_new_protected:Npn \__div_char:nn #1 #2
{
    \StrChar{#1}{#2}[\l_tmpa_tl]
}

% ------------------------------------------------------------
% Rendu principal
% ------------------------------------------------------------
\cs_new_protected:Npn \__op_rendre_division:nn #1 #2
{
    \group_begin:
    \keys_set:nn { outilsprof / division } { #1 }
    \__op_appliquer_taille:
    \__div_calculer:
    \__div_verifier_etapes:

    \bool_if:NTF \l__div_etapes_ok_bool
    {
        % ----- Ligne de départ des étapes -----
        \bool_if:NTF \l__op_solution_bool
            { \int_set:Nn \l_tmpd_int { 3 } }
            { \int_set:Nn \l_tmpd_int { 2 } }
        \int_set:Nn \l_tmpb_int
            { \l_tmpd_int + 2 * \l__div_nb_etapes_int }

        \noindent\makebox[\textwidth][c]{%
        \begin{tikzpicture}[
            x=1mm, y=1mm,
            every~node/.style={font=\small, inner~sep=0pt}
        ]
            % ===== Ligne 1 : chiffres du dividende =====
            \int_set:Nn \l_tmpc_int { 1 }
            \int_while_do:nNnn { \l_tmpc_int }
                < { \l__div_nbchiffres_int + 1 }
            {
                \__div_char:nn {\l__div_dividende_tl} {\l_tmpc_int}
                \node[anchor=center]
                    at ( { (\l_tmpc_int - 0.5) * \l__div_w_dim } ,
                         { -0.5 * \l__div_h_dim } )
                    { \l_tmpa_tl };
                \int_set:Nn \l_tmpc_int { \l_tmpc_int + 1 }
            }

            % ===== Ligne 1 : chiffres du diviseur =====
            \int_set:Nn \l_tmpc_int { 1 }
            \int_while_do:nNnn { \l_tmpc_int }
                < { \l__div_nbdiv_int + 1 }
            {
                \__div_char:nn {\l__div_diviseur_tl} {\l_tmpc_int}
                \node[anchor=center]
                    at ( { (\l__div_nbchiffres_int + \l_tmpc_int
                            - 0.5) * \l__div_w_dim } ,
                         { -0.5 * \l__div_h_dim } )
                    { \l_tmpa_tl };
                \int_set:Nn \l_tmpc_int { \l_tmpc_int + 1 }
            }

            % ===== Barre verticale =====
            \draw[line~width=\l__div_sep_dim]
                ( { \l__div_nbchiffres_int * \l__div_w_dim } ,
                  { 0 * \l__div_h_dim } )
                -- ( { \l__div_nbchiffres_int * \l__div_w_dim } ,
                     { -\l_tmpb_int * \l__div_h_dim } );

            % ===== Quotient (si solution) =====
            \bool_if:NT \l__op_solution_bool
            {
                \int_set:Nn \l_tmpd_int { 1 }
                \int_while_do:nNnn { \l_tmpd_int }
                    < { \l__div_nbquo_int + 1 }
                {
                    \__div_char:nn {\l__div_quotient_tl} {\l_tmpd_int}
                    \node[anchor=center]
                        at ( { (\l__div_nbchiffres_int + \l_tmpd_int
                                - 0.5) * \l__div_w_dim } ,
                             { -1.5 * \l__div_h_dim } )
                        { \l_tmpa_tl };
                    \int_set:Nn \l_tmpd_int { \l_tmpd_int + 1 }
                }
            }

            % ===== Trait sous le diviseur (toujours affiché) =====
            \draw[line~width=\l__div_sep_dim]
                ( { \l__div_nbchiffres_int * \l__div_w_dim } ,
                  { -1 * \l__div_h_dim } )
                -- ( { (\l__div_nbchiffres_int
                       + \l__div_nbcol_droite_int)
                       * \l__div_w_dim } ,
                     { -1 * \l__div_h_dim } );

            % ===== Étapes (uniquement si fournies) =====
            \bool_if:NT \l__div_etapes_fournies_bool
            {
                \int_set:Nn \l_tmpc_int { 1 }
                \int_while_do:nNnn { \l_tmpc_int }
                    < { \l__div_nb_etapes_int + 1 }
                {
                    \tl_set:Nx \l_tmpa_tl
                        { \seq_item:Nn \l__div_etapes_calc_seq
                            { \l_tmpc_int } }
                    \__div_decouper_trois:

                    \int_set:Nn \l__div_position_int { \l_tmpa_tl }

                    % Ligne du produit : 2 + 2*(k-1)
                    \int_set:Nn \l_tmpa_int
                        { 2 + 2 * (\l_tmpc_int - 1) }

                    % ----- Produit chiffre par chiffre -----
                    \int_set:Nn \l__div_debut_int
                        { \l__div_position_int
                          - \tl_count:V \l_tmpc_tl + 1 }
                    \int_set:Nn \l_tmpd_int { 1 }
                    \int_while_do:nNnn { \l_tmpd_int }
                        < { \tl_count:V \l_tmpc_tl + 1 }
                    {
                        \__div_char:nn {\l_tmpc_tl} {\l_tmpd_int}
                        \node[anchor=center]
                            at ( { (\l__div_debut_int + \l_tmpd_int
                                    - 1.5) * \l__div_w_dim } ,
                                 { -(\l_tmpa_int - 0.5)
                                    * \l__div_h_dim } )
                            { \l_tmpa_tl };
                        \int_set:Nn \l_tmpd_int
                            { \l_tmpd_int + 1 }
                    }

                    % ----- Trait horizontal sous le produit -----
                    \draw[line~width=\l__div_sep_dim]
                        ( { 0 * \l__div_w_dim } ,
                          { -\l_tmpa_int * \l__div_h_dim } )
                        -- ( { \l__div_nbchiffres_int
                               * \l__div_w_dim } ,
                             { -\l_tmpa_int * \l__div_h_dim } );

                    % ----- Partiel suivant -----
                    \int_compare:nT
                        { \l_tmpc_int < \l__div_nb_etapes_int }
                    {
                        \tl_set:Nx \l_tmpa_tl
                            { \seq_item:Nn \l__div_etapes_calc_seq
                                { \l_tmpc_int + 1 } }
                        \__div_decouper_trois:
                        \int_set:Nn \l__div_position_int { \l_tmpa_tl }

                        \int_set:Nn \l__div_debut_int
                            { \l__div_position_int
                              - \tl_count:V \l_tmpb_tl + 1 }
                        \int_set:Nn \l_tmpd_int { 1 }
                        \int_while_do:nNnn { \l_tmpd_int }
                            < { \tl_count:V \l_tmpb_tl + 1 }
                        {
                            \__div_char:nn {\l_tmpb_tl}
                                {\l_tmpd_int}
                            \node[anchor=center]
                                at ( { (\l__div_debut_int
                                        + \l_tmpd_int - 1.5)
                                       * \l__div_w_dim } ,
                                     { -(\l_tmpa_int + 0.5)
                                        * \l__div_h_dim } )
                                { \l_tmpa_tl };
                            \int_set:Nn \l_tmpd_int
                                { \l_tmpd_int + 1 }
                        }
                    }

                    \int_set:Nn \l_tmpc_int { \l_tmpc_int + 1 }
                }
            }

            % ===== Reste final (si solution) =====
            \bool_if:NT \l__op_solution_bool
            {
                \int_compare:nT { \l__div_reste_int > 0 }
                {
                    \int_set:Nn \l__div_debut_int
                        { \l__div_nbchiffres_int
                          - \tl_count:V \l__div_reste_tl + 1 }
                    \int_set:Nn \l_tmpd_int { 1 }
                    \int_while_do:nNnn { \l_tmpd_int }
                        < { \tl_count:V \l__div_reste_tl + 1 }
                    {
                        \__div_char:nn {\l__div_reste_tl}
                            {\l_tmpd_int}
                        \node[anchor=center]
                            at ( { (\l__div_debut_int
                                    + \l_tmpd_int - 1.5)
                                   * \l__div_w_dim } ,
                                 { -(\l_tmpb_int - 2)
                                    * \l__div_h_dim } )
                            { \l_tmpa_tl };
                        \int_set:Nn \l_tmpd_int
                            { \l_tmpd_int + 1 }
                    }
                }
            }
        \end{tikzpicture}%
        }% fin \makebox
    }
    {
        \begin{tcolorbox}[
            colback=couleurVigilance!10,
            colframe=couleurVigilance,
            coltitle=white,
            fonttitle=\bfseries,
            arc=4pt, boxrule=1pt,
            title={\textbf{Erreur dans les étapes fournies}},
            top=3mm, bottom=3mm, left=3mm, right=3mm
        ]
            Les étapes fournies pour la division
            ne correspondent pas au calcul attendu.
        \end{tcolorbox}
    }
    \group_end:
}

% ------------------------------------------------------------
% Commande publique
% ------------------------------------------------------------
\NewDocumentCommand{\division}{O{}}{%
    \csname __op_rendre_division:nn\endcsname {#1}{}%
}

\ExplSyntaxOff

% ============================================================
% SECTION 3-B : OPÉRATIONS POSÉES (TikZ)
% ============================================================
% Syntaxe :
%   \addition[options]{terme1, terme2, ...}
%   \soustraction[options]{terme1, terme2}
%   \multiplication[options]{facteur1, facteur2}
%
% Options communes :
%   solution : bool — affiche le résultat
%   taille   : taille de police (normalsize par défaut)
%
% Rendu entièrement TikZ : aucun \halign, aucun &.
%
% MASQUAGE : un « | » placé devant un chiffre dans un terme
%   indique que ce chiffre participe au calcul mais est masqué
%   à l'affichage (remplacé par un rectangle gris clair).
%   Exemple : \addition[solution]{1|4, 56}
%              → calcul 14 + 56 = 70
%              → affichage « 1 □ » + « 5 6 » = « 7 0 »
% ============================================================

\ExplSyntaxOn

% ------------------------------------------------------------
% Variables internes
% ------------------------------------------------------------
\seq_new:N    \l__op_liste_seq
\seq_new:N    \l__op_liste_masquee_seq
\int_new:N    \l__op_somme_int
\int_new:N    \l__op_n_int
\int_new:N    \l__op_a_int
\int_new:N    \l__op_b_int
\int_new:N    \l__op_nb_int
\int_new:N    \l__op_chiffre_int
\int_new:N    \l__op_puissance_int
\int_new:N    \l__op_produit_int
\tl_new:N     \l__op_taille_tl
\tl_new:N     \l__op_resultat_tl
\seq_new:N    \l__op_produits_seq
\int_new:N    \l__op_nbchiffres_int

% ------------------------------------------------------------
% Paramètres géométriques TikZ (opérations)
% ------------------------------------------------------------
\dim_new:N \l__op_h_dim
\dim_new:N \l__op_w_dim
\dim_new:N \l__op_sep_dim
\dim_new:N \l__op_left_margin_dim
\dim_new:N \l__op_right_margin_dim
\dim_set:Nn \l__op_h_dim { 7mm }
\dim_set:Nn \l__op_w_dim { 5mm }
\dim_set:Nn \l__op_sep_dim { 0.4pt }
\dim_set:Nn \l__op_left_margin_dim { 8mm }
\dim_set:Nn \l__op_right_margin_dim { 2mm }

% ------------------------------------------------------------
% Options
% ------------------------------------------------------------
\keys_define:nn { outilsprof / operation }
{
    solution .bool_set:N = \l__op_solution_bool,
    solution .initial:n  = false,
    taille   .tl_set:N   = \l__op_taille_tl,
    taille   .initial:n  = normalsize,
}

\cs_new_protected:Npn \__op_appliquer_taille:
{
    \csname \l__op_taille_tl \endcsname
}

% ------------------------------------------------------------
% Masquage des chiffres avec « | »
% ------------------------------------------------------------

% Rectangle plein, sans contour, gris très clair
% Version TikZ pure : fiable dans tous les contextes (nœuds compris).
\cs_new_protected:Npn \__op_underscore:
{
    \tikz[baseline=-0.5ex]
        \fill[gray!20] (0,0) rectangle (0.45em,0.7em);
}

% Nettoyage : retire les « | » pour le calcul
\cs_new_protected:Npn \__op_nettoie:nN #1 #2
{
    \tl_set:Nx \l_tmpa_tl { \tl_to_str:n {#1} }
    \tl_clear:N #2
    \tl_map_inline:Nn \l_tmpa_tl
    {
        \tl_if_eq:nnF {##1} { | }
            { \tl_put_right:Nn #2 {##1} }
    }
}

% Masquage : « |X » devient un rectangle (X masqué)
\cs_new_protected:Npn \__op_masque:nN #1 #2
{
    \tl_set:Nx \l_tmpa_tl { \tl_to_str:n {#1} }
    \tl_clear:N #2
    \bool_set_false:N \l_tmpa_bool
    \tl_map_inline:Nn \l_tmpa_tl
    {
        \bool_if:NTF \l_tmpa_bool
            {
                % On sort d'un « | » : écrire le rectangle
                \tl_put_right:Nn #2 { \__op_underscore: }
                \tl_if_eq:nnTF {##1} { | }
                    { }   % « || » : rester en mode masquage
                    { \bool_set_false:N \l_tmpa_bool }
            }
            {
                \tl_if_eq:nnTF {##1} { | }
                    { \bool_set_true:N \l_tmpa_bool }
                    { \tl_put_right:Nn #2 {##1} }
            }
    }
    % Si on finit sur un « | », insérer un rectangle pour le 0 implicite
    \bool_if:NT \l_tmpa_bool
        { \tl_put_right:Nn #2 { \__op_underscore: } }
}

% ------------------------------------------------------------
% Parse la liste des termes (séparés par des virgules)
% Remplit \l__op_liste_seq (nettoyée) et
%         \l__op_liste_masquee_seq (masquée)
% ------------------------------------------------------------
\cs_new_protected:Npn \__op_parse:n #1
{
    \seq_clear:N \l__op_liste_seq
    \seq_clear:N \l__op_liste_masquee_seq
    \clist_map_inline:nn { #1 }
    {
        \tl_set:Nn \l_tmpa_tl {##1}
        \tl_replace_all:Nnn \l_tmpa_tl { ~ } { }
        \tl_replace_all:Nnn \l_tmpa_tl { \c_space_token } { }
        \tl_if_empty:NF \l_tmpa_tl
            {
                % Version nettoyée (pour calcul)
                \__op_nettoie:nN {##1} \l_tmpb_tl
                \seq_put_right:NV \l__op_liste_seq \l_tmpb_tl
                % Version masquée (pour affichage)
                \__op_masque:nN {##1} \l_tmpc_tl
                \seq_put_right:NV \l__op_liste_masquee_seq \l_tmpc_tl
            }
    }
    \int_set:Nn \l__op_n_int { \seq_count:N \l__op_liste_seq }
}

% ------------------------------------------------------------
% Calcule la somme des termes de la liste
% ------------------------------------------------------------
\cs_new_protected:Npn \__op_calculer_somme:
{
    \int_zero:N \l__op_somme_int
    \seq_map_inline:Nn \l__op_liste_seq
    {
        \int_set:Nn \l_tmpa_int {##1}
        \int_add:Nn \l__op_somme_int { \l_tmpa_int }
    }
}

% ------------------------------------------------------------
% Affiche un entier formaté (via siunitx)
% ------------------------------------------------------------
\cs_new_protected:Npn \__op_afficher_nombre:n #1
{
    \tl_set:Nx \l_tmpa_tl {#1}
    \exp_args:NV \num \l_tmpa_tl
}

% ------------------------------------------------------------
% Calcule le nombre de chiffres d'un entier
% ------------------------------------------------------------
\cs_new_protected:Npn \__op_nbchiffres:n #1
{
    \int_set:Nn \l_tmpa_int { \tl_count:n {#1} }
}

% ============================================================
% ADDITION
% ============================================================
\cs_new_protected:Npn \__op_rendre_addition:nn #1 #2
{
    \group_begin:
    \keys_set:nn { outilsprof / operation } { #1 }
    \__op_parse:n { #2 }
    \__op_calculer_somme:
    \tl_set:Nx \l__op_resultat_tl { \int_use:N \l__op_somme_int }
    \__op_appliquer_taille:

    \int_set:Nn \l_tmpa_int { \l__op_n_int }
    \bool_if:NT \l__op_solution_bool
        { \int_set:Nn \l_tmpa_int { \l_tmpa_int + 2 } }

    % Nombre max de chiffres (variable dédiée)
    \int_set:Nn \l__op_nbchiffres_int { 0 }
    \seq_map_inline:Nn \l__op_liste_seq
    {
        \int_set:Nn \l_tmpc_int { \tl_count:n {##1} }
        \int_compare:nT { \l_tmpc_int > \l__op_nbchiffres_int }
            { \int_set:Nn \l__op_nbchiffres_int { \l_tmpc_int } }
    }
    \bool_if:NT \l__op_solution_bool
    {
        \int_set:Nn \l_tmpc_int { \tl_count:V \l__op_resultat_tl }
        \int_compare:nT { \l_tmpc_int > \l__op_nbchiffres_int }
            { \int_set:Nn \l__op_nbchiffres_int { \l_tmpc_int } }
    }

    \dim_set:Nn \l_tmpa_dim
    { \l__op_left_margin_dim
      + \l__op_nbchiffres_int \l__op_w_dim
      + \l__op_right_margin_dim }

    \begin{center}
    \raisebox{-0.5\height}{%
    \begin{tikzpicture}[
        x=1mm, y=1mm,
        every~node/.style={font=\small, inner~sep=0pt}
    ]
        % ----- Termes (version masquée pour l'affichage) -----
        \int_set:Nn \l_tmpc_int { 1 }
        \seq_map_inline:Nn \l__op_liste_masquee_seq
        {
            \int_compare:nTF { \l_tmpc_int == 1 }
                { }
                { \node[anchor=east] at ( { \l__op_left_margin_dim - 1mm } ,
                        { -(\l_tmpc_int - 0.5) * \l__op_h_dim } ) {$+$}; }
            \node[anchor=east]
                at ( { \l__op_left_margin_dim
                       + \l__op_nbchiffres_int * \l__op_w_dim } ,
                     { -(\l_tmpc_int - 0.5) * \l__op_h_dim } )
                { ##1 };
            \int_set:Nn \l_tmpc_int { \l_tmpc_int + 1 }
        }

               % ----- Trait -----
        \int_set:Nn \l_tmpa_int { \l__op_n_int }
        \draw[line~width=\l__op_sep_dim]
            ( { \l__op_left_margin_dim - 2mm } ,
              { -\l_tmpa_int * \l__op_h_dim - 0.0mm } )
            -- ( { \l__op_left_margin_dim
                   + \l__op_nbchiffres_int * \l__op_w_dim } ,
                 { -\l_tmpa_int * \l__op_h_dim - 0.0mm } );

        % ----- Résultat -----
        \bool_if:NT \l__op_solution_bool
        {
            \node[anchor=east]
                at ( { \l__op_left_margin_dim
                       + \l__op_nbchiffres_int * \l__op_w_dim } ,
                     { -\l_tmpa_int * \l__op_h_dim - 3mm } )
                { \__op_afficher_nombre:n { \l__op_resultat_tl } };
        }
    \end{tikzpicture}%
    }% fin \raisebox
    \end{center}
    \group_end:
}

% ============================================================
% SOUSTRACTION
% ============================================================
\cs_new_protected:Npn \__op_rendre_soustraction:nn #1 #2
{
    \group_begin:
    \keys_set:nn { outilsprof / operation } { #1 }
    \__op_parse:n { #2 }
    \int_compare:nTF { \l__op_n_int == 2 }
    {
        % Versions nettoyées (pour calcul)
        \tl_set:Nx \l_tmpc_tl { \seq_item:Nn \l__op_liste_seq { 1 } }
        \tl_set:Nx \l_tmpd_tl { \seq_item:Nn \l__op_liste_seq { 2 } }
        % Versions masquées (pour affichage)
        \tl_set:Nx \l_tmpa_tl
            { \seq_item:Nn \l__op_liste_masquee_seq { 1 } }
        \tl_set:Nx \l_tmpb_tl
            { \seq_item:Nn \l__op_liste_masquee_seq { 2 } }

        \int_set:Nn \l_tmpa_int { \l_tmpc_tl }
        \int_set:Nn \l_tmpb_int { \l_tmpd_tl }
        \int_compare:nTF { \l_tmpa_int >= \l_tmpb_int }
        {
            \int_set:Nn \l__op_somme_int { \l_tmpa_int - \l_tmpb_int }
        }
        {
            % Échange : on permute les 4 variables
            \tl_set_eq:NN \l_tmpc_tl \l_tmpa_tl
            \tl_set_eq:NN \l_tmpd_tl \l_tmpb_tl
            \tl_set:Nx \l_tmpa_tl
                { \seq_item:Nn \l__op_liste_masquee_seq { 2 } }
            \tl_set:Nx \l_tmpb_tl
                { \seq_item:Nn \l__op_liste_masquee_seq { 1 } }
            % Recalcul avec les valeurs dans le bon ordre
            \tl_set:Nx \l_tmpc_tl
                { \seq_item:Nn \l__op_liste_seq { 2 } }
            \tl_set:Nx \l_tmpd_tl
                { \seq_item:Nn \l__op_liste_seq { 1 } }
            \int_set:Nn \l_tmpa_int { \l_tmpc_tl }
            \int_set:Nn \l_tmpb_int { \l_tmpd_tl }
            \int_set:Nn \l__op_somme_int { \l_tmpa_int - \l_tmpb_int }
        }
        \tl_set:Nx \l__op_resultat_tl { \int_use:N \l__op_somme_int }
        \__op_appliquer_taille:

        \int_set:Nn \l_tmpb_int { \tl_count:V \l_tmpc_tl }
        \int_set:Nn \l_tmpc_int { \tl_count:V \l_tmpd_tl }
        \int_compare:nT { \l_tmpc_int > \l_tmpb_int }
            { \int_set:Nn \l_tmpb_int { \l_tmpc_int } }
        \bool_if:NT \l__op_solution_bool
        {
            \int_set:Nn \l_tmpc_int { \tl_count:V \l__op_resultat_tl }
            \int_compare:nT { \l_tmpc_int > \l_tmpb_int }
                { \int_set:Nn \l_tmpb_int { \l_tmpc_int } }
        }

        \begin{center}
        \raisebox{-0.5\height}{%
        \begin{tikzpicture}[
            x=1mm, y=1mm,
            every~node/.style={font=\small, inner~sep=0pt}
        ]
            % Premier terme (version masquée)
            \node[anchor=east]
                at ( { \l__op_left_margin_dim
                       + \l_tmpb_int * \l__op_w_dim } ,
                     { -0.5 * \l__op_h_dim } )
                { \l_tmpa_tl };
            % Signe -
            \node[anchor=east]
                at ( { \l__op_left_margin_dim - 1mm } ,
                     { -1.5 * \l__op_h_dim } )
                {$-$};
            % Second terme (version masquée)
            \node[anchor=east]
                at ( { \l__op_left_margin_dim
                       + \l_tmpb_int * \l__op_w_dim } ,
                     { -1.5 * \l__op_h_dim } )
                { \l_tmpb_tl };
            % Trait
            \draw[line~width=\l__op_sep_dim]
                ( { \l__op_left_margin_dim - 2mm } ,
                  { -2 * \l__op_h_dim + 1.5mm } )
                -- ( { \l__op_left_margin_dim
                       + \l_tmpb_int * \l__op_w_dim } ,
                     { -2 * \l__op_h_dim + 1.5mm } );
            % Résultat
            \bool_if:NT \l__op_solution_bool
            {
                \node[anchor=east]
                    at ( { \l__op_left_margin_dim
                           + \l_tmpb_int * \l__op_w_dim } ,
                         { -2.2 * \l__op_h_dim } )
                    { \__op_afficher_nombre:n { \l__op_resultat_tl } };
            }
        \end{tikzpicture}%
        }% fin \raisebox
        \end{center}
    }
    {
        \GenericError{}
            {outilsprof : \soustraction~attend~exactement~2~termes}
            {Voir~la~documentation~de~outilsprof}
            {Exemple~:~\soustraction\{853,~476\}}
    }
    \group_end:
}

% ============================================================
% MULTIPLICATION
% ============================================================
\cs_new_protected:Npn \__op_rendre_multiplication:nn #1 #2
{
    \group_begin:
    \keys_set:nn { outilsprof / operation } { #1 }
    \__op_parse:n { #2 }

    \int_compare:nTF { \l__op_n_int == 2 }
    {
        % Versions nettoyées (pour calcul)
        \tl_set:Nx \l_tmpc_tl { \seq_item:Nn \l__op_liste_seq { 1 } }
        \tl_set:Nx \l_tmpd_tl { \seq_item:Nn \l__op_liste_seq { 2 } }
        % Versions masquées (pour affichage)
        \tl_set:Nx \l_tmpa_tl
            { \seq_item:Nn \l__op_liste_masquee_seq { 1 } }
        \tl_set:Nx \l_tmpb_tl
            { \seq_item:Nn \l__op_liste_masquee_seq { 2 } }

        \int_set:Nn \l__op_a_int { \l_tmpc_tl }
        \int_set:Nn \l__op_b_int { \l_tmpd_tl }

        \int_set:Nn \l__op_nb_int { \tl_count:V \l_tmpd_tl }

        \tl_set:Nx \l__op_resultat_tl
            { \int_eval:n { \l__op_a_int * \l__op_b_int } }

        \seq_clear:N \l__op_produits_seq
        \int_compare:nT { \l__op_nb_int > 1 }
        {
            \int_set:Nn \l__op_puissance_int { 1 }
            \int_set:Nn \l_tmpc_int { 1 }
            \int_while_do:nNnn { \l_tmpc_int }
                < { \l__op_nb_int + 1 }
            {
                \int_set:Nn \l__op_chiffre_int
                    { \int_mod:nn
                        { \int_div_truncate:nn
                            { \l__op_b_int }
                            { \l__op_puissance_int } }
                        { 10 } }
                \int_set:Nn \l__op_produit_int
                    { \l__op_a_int * \l__op_chiffre_int
                      * \l__op_puissance_int }
                \seq_put_right:Nx \l__op_produits_seq
                    { \int_use:N \l__op_produit_int }
                \int_set:Nn \l__op_puissance_int
                    { \l__op_puissance_int * 10 }
                \int_set:Nn \l_tmpc_int { \l_tmpc_int + 1 }
            }
        }

        \__op_appliquer_taille:

        \int_set:Nn \l_tmpb_int { 0 }
        \int_set:Nn \l_tmpc_int { \tl_count:V \l_tmpc_tl }
        \int_compare:nT { \l_tmpc_int > \l_tmpb_int }
            { \int_set:Nn \l_tmpb_int { \l_tmpc_int } }
        \int_set:Nn \l_tmpc_int { \tl_count:V \l_tmpd_tl }
        \int_compare:nT { \l_tmpc_int > \l_tmpb_int }
            { \int_set:Nn \l_tmpb_int { \l_tmpc_int } }
        \seq_map_inline:Nn \l__op_produits_seq
        {
            \int_set:Nn \l_tmpc_int { \tl_count:n {##1} }
            \int_compare:nT { \l_tmpc_int > \l_tmpb_int }
                { \int_set:Nn \l_tmpb_int { \l_tmpc_int } }
        }
        \bool_if:NT \l__op_solution_bool
        {
            \int_set:Nn \l_tmpc_int { \tl_count:V \l__op_resultat_tl }
            \int_compare:nT { \l_tmpc_int > \l_tmpb_int }
                { \int_set:Nn \l_tmpb_int { \l_tmpc_int } }
        }

        \int_set:Nn \l_tmpa_int { 3 }
        \int_compare:nT { \l__op_nb_int > 1 }
            { \int_set:Nn \l_tmpa_int { 2 } }
        \int_add:Nn \l_tmpa_int { \l__op_nb_int }
        \int_compare:nT { \l__op_nb_int > 1 }
            { \int_set:Nn \l_tmpa_int { \l_tmpa_int + 1 } }
        \bool_if:NT \l__op_solution_bool
            { \int_set:Nn \l_tmpa_int { \l_tmpa_int + 1 } }

        \begin{center}
        \raisebox{-0.5\height}{%
        \begin{tikzpicture}[
            x=1mm, y=1mm,
            every~node/.style={font=\small, inner~sep=0pt}
        ]
            % ----- Ligne 1 : multiplicande (version masquée) -----
            \node[anchor=east]
                at ( { \l__op_left_margin_dim
                       + \l_tmpb_int * \l__op_w_dim } ,
                     { -0.5 * \l__op_h_dim } )
                { \l_tmpa_tl };

            % ----- Ligne 2 : signe × et multiplicateur -----
            \node[anchor=east]
                at ( { \l__op_left_margin_dim - 1mm } ,
                     { -1.5 * \l__op_h_dim } )
                {$\times$};
            \node[anchor=east]
                at ( { \l__op_left_margin_dim
                       + \l_tmpb_int * \l__op_w_dim } ,
                     { -1.5 * \l__op_h_dim } )
                { \l_tmpb_tl };

           % ----- Trait sous les facteurs (toujours affiché) -----
            \draw[line~width=\l__op_sep_dim]
                ( { \l__op_left_margin_dim - 2mm } ,
                  { -2 * \l__op_h_dim + 0.5mm } )
                -- ( { \l__op_left_margin_dim
                       + \l_tmpb_int * \l__op_w_dim } ,
                     { -2 * \l__op_h_dim + 0.5mm } );

            % ----- Produits partiels : place réservée + trait -----
            \int_compare:nT { \l__op_nb_int > 1 }
            {
                % Trait sous les produits partiels (toujours affiché)
                \int_set:Nn \l_tmpd_int { 2 + \l__op_nb_int }
                \draw[line~width=\l__op_sep_dim]
                    ( { \l__op_left_margin_dim - 2mm } ,
                      { -\l_tmpd_int * \l__op_h_dim + 0.5mm } )
                    -- ( { \l__op_left_margin_dim
                           + \l_tmpb_int * \l__op_w_dim } ,
                         { -\l_tmpd_int * \l__op_h_dim + 0.5mm } );

                % Valeurs des produits partiels : uniquement si solution
                \bool_if:NT \l__op_solution_bool
                {
                    \int_set:Nn \l_tmpc_int { 0 }
                    \seq_map_inline:Nn \l__op_produits_seq
                    {
                        \int_set:Nn \l_tmpc_int { \l_tmpc_int + 1 }
                        \int_set:Nn \l_tmpd_int { 2 + \l_tmpc_int }
                        \node[anchor=east]
                            at ( { \l__op_left_margin_dim
                                   + \l_tmpb_int * \l__op_w_dim } ,
                                 { -(\l_tmpd_int - 0.5) * \l__op_h_dim } )
                            { \__op_afficher_nombre:n {##1} };
                    }
                }
            }

            % ----- Résultat final (uniquement si solution) -----
            \bool_if:NT \l__op_solution_bool
            {
                \int_set:Nn \l_tmpd_int
                    { 2 + \l__op_nb_int + 1 }
                \int_compare:nT { \l__op_nb_int == 1 }
                    { \int_set:Nn \l_tmpd_int { 3 } }
                \node[anchor=east]
                    at ( { \l__op_left_margin_dim
                           + \l_tmpb_int * \l__op_w_dim } ,
                         { -(\l_tmpd_int - 0.7) * \l__op_h_dim } )
                    { \__op_afficher_nombre:n { \l__op_resultat_tl } };
            }
        \end{tikzpicture}%
        }% fin \raisebox
        \end{center}
    }
    {
        \GenericError{}
            {outilsprof : \multiplication~attend~exactement~2~facteurs}
            {Voir~la~documentation~de~outilsprof}
            {Exemple~:\multiplication\{234,~56\}}
    }
    \group_end:
}

\ExplSyntaxOff

