            \int_compare:nT { \seq_count:N \l__dop_parts_seq >= 1 }
                {
                    \__dop_mask:n { \seq_item:Nn \l__dop_parts_seq {1} }
                    \node[anchor=east]
                        at ( 22mm , { -(#2 - 0.5) * 6mm } )
                        { \dopMaskedContent };
                    \node[anchor=west]
                        at ( 23mm , { -(#2 - 0.5) * 6mm } )
                        { \ensuremath{{}^\circ} };
                }
            \int_compare:nT { \seq_count:N \l__dop_parts_seq >= 2 }
                {
                    \__dop_mask:n { \seq_item:Nn \l__dop_parts_seq {2} }
                    \node[anchor=east]
                        at ( 40mm , { -(#2 - 0.5) * 6mm } )
                        { \dopMaskedContent };
                    \node[anchor=west]
                        at ( 41mm , { -(#2 - 0.5) * 6mm } )
                        { \ensuremath{{}^\prime} };
                }
            \int_compare:nT { \seq_count:N \l__dop_parts_seq >= 3 }
                {
                    \__dop_mask:n { \seq_item:Nn \l__dop_parts_seq {3} }
                    \node[anchor=east]
                        at ( 58mm , { -(#2 - 0.5) * 6mm } )
                        { \dopMaskedContent };
                    \node[anchor=west]
                        at ( 59mm , { -(#2 - 0.5) * 6mm } )
                        { \ensuremath{{}^{\prime\prime}} };
                }
        }
        {
            \int_compare:nT { \seq_count:N \l__dop_parts_seq >= 1 }
                {
                    \__dop_mask:n { \seq_item:Nn \l__dop_parts_seq {1} }
                    \node[anchor=east]
                        at ( 14mm , { -(#2 - 0.5) * 6mm } )
                        { \dopMaskedContent };
                    \node[anchor=west]
                        at ( 15mm , { -(#2 - 0.5) * 6mm } )
                        { j };
                }
            \int_compare:nT { \seq_count:N \l__dop_parts_seq >= 2 }
                {
                    \__dop_mask:n { \seq_item:Nn \l__dop_parts_seq {2} }
                    \node[anchor=east]
