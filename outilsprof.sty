% ============================================================
% SECTION 4 : GRANDEURS, ANGLES, DURÉES ET OPÉRATIONS
% ============================================================
% SÉPARATEUR UNIQUE : le signe « + » pour les listes de valeurs
%
% Syntaxe :
%   \unite{6}{m}                 → 6 m
%   \unite{5}{m^2}               → 5 m²
%   \unite{9,81}{m/s^2}          → 9,81 m/s²
%
%   \degre{56}                   → 56°
%   \degre{56+30}                → 56°30′
%   \degre{56+30+15}             → 56°30′15″
%
%   \dureeminute{12}             → 12 min
%   \dureeminute{12+30}          → 12 min 30 s
%   \dureeheure{5}               → 5 h
%   \dureeheure{5+45}            → 5 h 45 min
%   \dureeheure{5+45+30}         → 5 h 45 min 30 s
%   \dureejour{3}                → 3 j
%   \dureejour{3+12}             → 3 j 12 h
%   \dureejour{3+12+30+15}       → 3 j 12 h 30 min 15 s
%   \dureesemaine{2}             → 2 sem
%   \dureesemaine{2+3+12+30+15}  → 2 sem 3 j 12 h 30 min 15 s
%
%   \additiondurees[solution]{3+12, 5+30}
%   \soustractiondurees[solution]{5+30, 2+45}
%   \additionangles[solution]{56+30, 12+45}
%   \soustractionangles[solution]{56+30+15, 12+45+30}
%
% NOTE : les nombres se saisissent avec la virgule décimale
%        (ex. \unite{9,81}{m/s^2}).
% ============================================================

% ------------------------------------------------------------
% 4-0 : Déclaration des unités personnalisées
% ------------------------------------------------------------
\DeclareSIUnit{\jour}{j}
\DeclareSIUnit{\semaine}{sem}

% ------------------------------------------------------------
% 4-A : Grandeurs et unités
% ------------------------------------------------------------
\NewDocumentCommand{\unite}{m m}{%
    \SI{#1}{#2}%
}

% ------------------------------------------------------------
% 4-B : Angles (degrés, minutes, secondes)
% ------------------------------------------------------------
\ExplSyntaxOn

\seq_new:N \l__angle_parts_seq
\int_new:N \l__angle_i_int

\cs_new_protected:Npn \__angle_afficher:n #1
{
    \seq_set_split:Nnn \l__angle_parts_seq { + } { #1 }
    \int_set:Nn \l__angle_i_int { 1 }
    \seq_map_inline:Nn \l__angle_parts_seq
    {
        \int_compare:nTF { \l__angle_i_int == 1 }
            { ##1 \ensuremath{{}^\circ} }
            {
                \int_compare:nTF { \l__angle_i_int == 2 }
                    { \, ##1 \ensuremath{{}^\prime} }
                    { \, ##1 \ensuremath{{}^{\prime\prime}} }
            }
        \int_set:Nn \l__angle_i_int { \l__angle_i_int + 1 }
    }
}

\providecommand{\degre}{}
\RenewDocumentCommand{\degre}{m}{%
    \__angle_afficher:n {#1}%
}

\ExplSyntaxOff

% ------------------------------------------------------------
% 4-C : Durées simples
% ------------------------------------------------------------
\ExplSyntaxOn

\seq_new:N \l__duree_valeurs_seq
\seq_new:N \l__duree_unites_seq
\int_new:N \l__duree_i_int

\cs_new_protected:Npn \__duree_afficher:nn #1 #2
{
    \seq_set_split:Nnn \l__duree_valeurs_seq { + } { #1 }
    \seq_set_split:Nnn \l__duree_unites_seq  { + } { #2 }

    \int_set:Nn \l__duree_i_int { 1 }
    \int_while_do:nNnn { \l__duree_i_int }
        < { \seq_count:N \l__duree_valeurs_seq + 1 }
    {
        \int_compare:nT { \l__duree_i_int > 1 } { ~ }
        \SI
            { \seq_item:Nn \l__duree_valeurs_seq { \l__duree_i_int } }
            { \seq_item:Nn \l__duree_unites_seq  { \l__duree_i_int } }
        \int_set:Nn \l__duree_i_int { \l__duree_i_int + 1 }
    }
}

\NewDocumentCommand{\dureeminute}{m}{%
    \__duree_afficher:nn {#1}{\minute+\second}%
}
\NewDocumentCommand{\dureeheure}{m}{%
    \__duree_afficher:nn {#1}{\hour+\minute+\second}%
}
\NewDocumentCommand{\dureejour}{m}{%
    \__duree_afficher:nn {#1}{\jour+\hour+\minute+\second}%
}
\NewDocumentCommand{\dureesemaine}{m}{%
    \__duree_afficher:nn {#1}{\semaine+\jour+\hour+\minute+\second}%
}

\ExplSyntaxOff

% ============================================================
% 4-D : OPÉRATIONS SUR DURÉES ET ANGLES
% ============================================================
% Syntaxe :
%   \additiondurees[solution]{3+12, 5+30}
%   \soustractiondurees[solution]{5+30, 2+45}
%   \additionangles[solution]{56+30, 12+45}
%   \soustractionangles[solution]{56+30+15, 12+45+30}
%
% Chaque terme est une liste séparée par « + » :
%   DURÉES  : [jours]+[heures]+[minutes]+[secondes]
%   ANGLES  : [degrés]+[minutes]+[secondes]
% Les composantes manquantes sont implicitement 0.
%
% Options communes :
%   solution : bool — affiche le résultat (défaut : false)
%
% MASQUAGE : un « | » placé dans une composante masque le chiffre
%   qui suit (remplacé par un underscore bas). Le chiffre reste
%   utilisé dans le calcul.
%   Exemple : \additiondurees[solution]{3+1|2, 5+30}
%              → calcul 3 j 12 h + 5 h 30 min
%              → affichage « 3 j 1 _ h » + « 5 h 30 min »
%
% Affichage : les composantes nulles à droite sont masquées,
%             les colonnes sont alignées verticalement,
%             le trait s'arrête à la dernière colonne utilisée
%             par les termes (le résultat n'intervient pas),
%             un signe « − » apparaît si le résultat est négatif.
% ============================================================

\ExplSyntaxOn

% ------------------------------------------------------------
% Variables internes
% ------------------------------------------------------------
\seq_new:N   \l__dop_termes_seq
\seq_new:N   \l__dop_parts_seq
\int_new:N   \l__dop_nb_int
\int_new:N   \l__dop_i_int
\int_new:N   \l__dop_ligne_int
\int_new:N   \l__dop_hauteur_int
\int_new:N   \l__dop_derniere_col_int
\dim_new:N   \l__dop_fin_dim
\tl_new:N    \l__dop_clean_tl
\tl_new:N    \l__dop_masked_tl
\str_new:N   \l__dop_str
\bool_new:N  \l__dop_mask_bool
\bool_new:N  \l__dop_solution_bool
\bool_new:N  \l__dop_angles_bool
\bool_new:N  \l__dop_addition_bool

% Cumul global (réinitialisé à chaque appel)
\int_new:N \g__dop_j_int
\int_new:N \g__dop_h_int
\int_new:N \g__dop_m_int
\int_new:N \g__dop_s_int
\int_new:N \g__dop_total_int
\int_new:N \g__dop_signe_int

% ------------------------------------------------------------
% Export vers un nom LaTeX2e pour TikZ
% ------------------------------------------------------------
\cs_new:Npn \dopMaskedContent {}

% ------------------------------------------------------------
% Options
% ------------------------------------------------------------
\keys_define:nn { outilsprof / dureeop }
{
    solution .bool_set:N = \l__dop_solution_bool,
    solution .initial:n  = false,
}

% ------------------------------------------------------------
% Nettoyage d'une composante : retire les « | » pour le calcul
% \str_set:Nx expanse d'abord (donc \seq_item:Nn donne "12"),
% puis convertit en chaîne à catcode uniforme (12).
% ------------------------------------------------------------
\cs_new_protected:Npn \__dop_clean:n #1
{
    \str_set:Nx \l__dop_str { #1 }
    \tl_clear:N \l__dop_clean_tl
    \str_map_inline:Nn \l__dop_str
    {
        \str_if_eq:nnF {##1} { | }
            { \tl_put_right:Nn \l__dop_clean_tl {##1} }
    }
}

% ------------------------------------------------------------
% Masquage d'une composante : chaque « |X » devient un « _ »
% Résultat dans \dopMaskedContent (compatible TikZ).
% ------------------------------------------------------------
\cs_new_protected:Npn \__dop_mask:n #1
{
    \str_set:Nx \l__dop_str { #1 }
    \tl_clear:N \l__dop_masked_tl
    \bool_set_false:N \l__dop_mask_bool
    \str_map_inline:Nn \l__dop_str
    {
        \bool_if:NTF \l__dop_mask_bool
            {
                \tl_put_right:Nn \l__dop_masked_tl { \__op_underscore: }
                \str_if_eq:nnTF {##1} { | }
                    { }
                    { \bool_set_false:N \l__dop_mask_bool }
            }
            {
                \str_if_eq:nnTF {##1} { | }
                    { \bool_set_true:N \l__dop_mask_bool }
                    { \tl_put_right:Nn \l__dop_masked_tl {##1} }
            }
    }
    \bool_if:NT \l__dop_mask_bool
        { \tl_put_right:Nn \l__dop_masked_tl { \__op_underscore: } }
    \cs_set:Npx \dopMaskedContent { \l__dop_masked_tl }
}

% ------------------------------------------------------------
% Extraction des composantes d'un terme « a+b+c+d »
% ------------------------------------------------------------
\cs_new_protected:Npn \__dop_parse:n #1
{
    \seq_set_split:Nnn \l__dop_parts_seq { + } { #1 }
    \int_zero:N \l_tmpa_int
    \int_zero:N \l_tmpb_int
    \int_zero:N \l_tmpc_int
    \int_zero:N \l_tmpd_int
    \int_set:Nn \l__dop_i_int { \seq_count:N \l__dop_parts_seq }
    \int_compare:nT { \l__dop_i_int >= 1 }
        {
            \__dop_clean:n { \seq_item:Nn \l__dop_parts_seq {1} }
            \int_set:Nn \l_tmpa_int { \l__dop_clean_tl }
        }
    \int_compare:nT { \l__dop_i_int >= 2 }
        {
            \__dop_clean:n { \seq_item:Nn \l__dop_parts_seq {2} }
            \int_set:Nn \l_tmpb_int { \l__dop_clean_tl }
        }
    \int_compare:nT { \l__dop_i_int >= 3 }
        {
            \__dop_clean:n { \seq_item:Nn \l__dop_parts_seq {3} }
            \int_set:Nn \l_tmpc_int { \l__dop_clean_tl }
        }
    \int_compare:nT { \l__dop_i_int >= 4 }
        {
            \__dop_clean:n { \seq_item:Nn \l__dop_parts_seq {4} }
            \int_set:Nn \l_tmpd_int { \l__dop_clean_tl }
        }
}

% ------------------------------------------------------------
% Calcul de la dernière colonne utilisée par les TERMES
% ------------------------------------------------------------
\cs_new_protected:Npn \__dop_calculer_derniere_col:
{
    \int_zero:N \l__dop_derniere_col_int

    \seq_map_inline:Nn \l__dop_termes_seq
    {
        \__dop_parse:n {##1}
        \int_compare:nT { \l_tmpa_int > 0 }
            { \int_set:Nn \l__dop_derniere_col_int
                { \int_max:nn { \l__dop_derniere_col_int } { 1 } } }
        \int_compare:nT { \l_tmpb_int > 0 }
            { \int_set:Nn \l__dop_derniere_col_int
                { \int_max:nn { \l__dop_derniere_col_int } { 2 } } }
        \int_compare:nT { \l_tmpc_int > 0 }
            { \int_set:Nn \l__dop_derniere_col_int
                { \int_max:nn { \l__dop_derniere_col_int } { 3 } } }
        \int_compare:nT { \l_tmpd_int > 0 }
            { \int_set:Nn \l__dop_derniere_col_int
                { \int_max:nn { \l__dop_derniere_col_int } { 4 } } }
    }
}

% ------------------------------------------------------------
% Position X de fin du trait selon la dernière colonne utilisée
% ------------------------------------------------------------
\cs_new_protected:Npn \__dop_calculer_fin_trait:
{
    \bool_if:NTF \l__dop_angles_bool
        {
            \int_compare:nTF { \l__dop_derniere_col_int == 1 }
                { \dim_set:Nn \l__dop_fin_dim { 30mm } }
                {
                    \int_compare:nTF { \l__dop_derniere_col_int == 2 }
                        { \dim_set:Nn \l__dop_fin_dim { 50mm } }
                        { \dim_set:Nn \l__dop_fin_dim { 68mm } }
                }
        }
        {
            \int_compare:nTF { \l__dop_derniere_col_int == 1 }
                { \dim_set:Nn \l__dop_fin_dim { 20mm } }
                {
                    \int_compare:nTF { \l__dop_derniere_col_int == 2 }
                        { \dim_set:Nn \l__dop_fin_dim { 38mm } }
                        {
                            \int_compare:nTF { \l__dop_derniere_col_int == 3 }
                                { \dim_set:Nn \l__dop_fin_dim { 63mm } }
                                { \dim_set:Nn \l__dop_fin_dim { 78mm } }
                        }
                }
        }
}

